{
  "description": "Recover context after compaction and review marked tasks before stopping.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/codex-useful-hooks/task_hook.py",
            "timeout": 3,
            "statusMessage": "Task check: Classify this turn",
            "additionalContextLimit": 1024
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/codex-useful-hooks/context_hook.py",
            "timeout": 30,
            "statusMessage": "Context recovery: Prepare history snapshot",
            "additionalContextLimit": 1024
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/codex-useful-hooks/task_hook.py",
            "timeout": 3,
            "statusMessage": "Task check: Review completion and clean up"
          }
        ]
      }
    ]
  }
}
